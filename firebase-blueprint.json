{
  "entities": {
    "RobuxCount": {
      "title": "RobuxCount",
      "description": "Store the robux vote counts for a character",
      "type": "object",
      "properties": {
        "count": {
          "type": "number",
          "description": "Total robux"
        }
      },
      "required": ["count"]
    },
    "CharacterComment": {
      "title": "CharacterComment",
      "description": "Public user comment or review for a character",
      "type": "object",
      "properties": {
        "characterId": {
          "type": "string",
          "description": "ID of the target character"
        },
        "userName": {
          "type": "string",
          "description": "Name or nickname of the commenter"
        },
        "commentText": {
          "type": "string",
          "description": "Text content of the comment (max 250 chars)"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when the comment was created in ms"
        },
        "parentId": {
          "type": "string",
          "description": "Optional ID of the parent comment being replied to"
        },
        "replyToUserName": {
          "type": "string",
          "description": "Optional name of the user being replied to"
        }
      },
      "required": ["characterId", "userName", "commentText", "createdAt"]
    },
    "Artwork": {
      "title": "Artwork",
      "description": "User submitted artwork for characters in the art gallery",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "Direct ImgBB link of the artwork"
        },
        "characterId": {
          "type": "string",
          "description": "Target character ID"
        },
        "characterName": {
          "type": "string",
          "description": "Name of the character"
        },
        "characterAvatarUrl": {
          "type": "string",
          "description": "Avatar URL of the character"
        },
        "authorName": {
          "type": "string",
          "description": "Artist or author name"
        },
        "title": {
          "type": "string",
          "description": "Optional title or poem caption"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        },
        "likesCount": {
          "type": "number",
          "description": "Total hearts / likes received"
        }
      },
      "required": ["imageUrl", "characterId", "characterName", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "/robux_counts/{characterId}": {
      "schema": "RobuxCount",
      "description": "Robux counts for characters"
    },
    "/rp_comments/{characterId}/items/{commentId}": {
      "schema": "CharacterComment",
      "description": "Public comments and reviews for a character"
    },
    "/artworks/{artworkId}": {
      "schema": "Artwork",
      "description": "Public artworks contributed by fans"
    }
  }
}
